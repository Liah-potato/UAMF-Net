{
  "classes": ["tubular_carcinoma", "poorly_cohesive_carcinoma", "benign"],
  "models": {
    "pathology": {"tag": "convnext_base.fb_in1k", "input_size": 224, "resize_size": 256},
    "ct": {"tag": "maxvit_tiny_tf_512.in1k", "input_size": 512, "resize_size": 544},
    "gastro": {"tag": "fastvit_ma36.apple_in1k", "input_size": 224, "resize_size": 256}
  },
  "normalization": {"mean": [0.485, 0.456, 0.406], "std": [0.229, 0.224, 0.225]},
  "pathology_views": 5,
  "policy": {
    "entropy_threshold": 0.45,
    "recall_threshold": 0.65,
    "benign_threshold": 0.80,
    "margin": 0.15,
    "tie_priority": "ct"
  },
  "training": {
    "mode": "head_only",
    "loss": "poly1",
    "poly_epsilon": 1.0,
    "label_smoothing": 0.0,
    "epochs": 20,
    "patience": 5,
    "batch_size": 16,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "workers": 4,
    "seed": 42,
    "amp": true
  }
}
